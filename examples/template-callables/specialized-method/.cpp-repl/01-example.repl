#include <api.hpp>

%define std::string specialized_method_demo::Person<int>::getName() const cpp` return "specialized int " + std::to_string(value); `
%define std::string specialized_method_demo::Person<double>::getName() const cpp` return "double instance"; `

specialized_method_demo::Person<int> person{7};
specialized_method_demo::Person<double> other{9.0};
person.getName()
std::string name = person.getName();
const char* text = name.c_str();
text
std::string other_name = other.getName();
const char* other_text = other_name.c_str();
other_text
bool matches = name == "specialized int 7" && other_name == "double instance";
matches
