#include <api.hpp>

template<class T> std::string class_instance_demo::Person<T>::getName() const { return "Person " + std::to_string(value); }

class_instance_demo::Person<int> person{7};
class_instance_demo::Person<long> other{9};
person.getName()
std::string name = person.getName();
const char* text = name.c_str();
text
std::string other_name = other.getName();
const char* other_text = other_name.c_str();
other_text
bool matches = name == "Person 7" && other_name == "Person 9";
matches
